/* SHOURYA // FOUNDRY — Design Tokens */

@theme {
  /* --- Colors --- */
  --color-background: #080808;
  --color-surface-primary: #121212;
  --color-surface-secondary: #1a1a1a;
  --color-surface-muted: #242424;
  --color-surface-transparent: rgba(255, 255, 255, 0.02);
  --color-text-primary: #f5f5f7;
  --color-text-secondary: #a1a1a6;
  --color-text-muted: #6e6e73;
  --color-accent: #c96a2b;
  --color-accent-hover: #e07a35;
  --color-border-precise: rgba(255, 255, 255, 0.05);
  --color-border-hover: rgba(255, 255, 255, 0.12);

  /* --- Spacing System --- */
  --spacing-space-1: 0.25rem;  /* 4px */
  --spacing-space-2: 0.5rem;   /* 8px */
  --spacing-space-3: 0.75rem;  /* 12px */
  --spacing-space-4: 1rem;     /* 16px */
  --spacing-space-6: 1.5rem;   /* 24px */
  --spacing-space-8: 2rem;     /* 32px */
  --spacing-space-10: 2.5rem;  /* 40px */
  --spacing-space-12: 3rem;    /* 48px */
  --spacing-space-16: 4rem;    /* 64px */

  /* --- Responsive Rhythm Gaps --- */
  --spacing-section-gap: clamp(6rem, 12vw, 16rem);
  --spacing-heading-gap: clamp(2.5rem, 5vw, 4.5rem);
  --spacing-block-gap: clamp(1.2rem, 2.5vw, 2.8rem);
  --spacing-large-section-break: clamp(8rem, 15vw, 22rem);
  --spacing-section-padding-x: clamp(1.5rem, 4vw, 3rem);

  /* --- Radius Scale --- */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  --radius-full: 9999px;

  /* --- Motion Durations --- */
  --animate-duration-fast: 150ms;
  --animate-duration-medium: 300ms;
  --animate-duration-slow: 500ms;
  --animate-duration-extra-slow: 800ms;

  /* --- Motion Easings --- */
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-entrance: cubic-bezier(0, 0, 0.2, 1);
  --ease-exit: cubic-bezier(0.4, 0, 1, 1);

  /* --- Container Widths --- */
  --spacing-container-editorial: 1536px;
  --spacing-container-showcase: 1800px;
  --spacing-container-content: 1200px;
  --spacing-container-narrow: 800px;

  /* --- Typography Families --- */
  --font-heading: 'General Sans', 'Inter', sans-serif;
  --font-body: 'Inter', sans-serif;

  /* --- Typography Sizes (Editorial Scale) --- */
  --text-display: clamp(3.5rem, 9vw, 7.5rem);
  --text-heading: clamp(2rem, 5vw, 3.5rem);
  --text-title: clamp(1.4rem, 3vw, 2.2rem);
  --text-body: clamp(0.95rem, 1.2vw, 1.1rem);
  --text-caption: clamp(0.75rem, 1vw, 0.85rem);
  --text-label: clamp(0.7rem, 0.9vw, 0.8rem);

  /* --- Typography tracking (letter-spacing) --- */
  --tracking-display: -0.04em;
  --tracking-heading: -0.03em;
  --tracking-title: -0.02em;
  --tracking-body: -0.01em;
  --tracking-caption: 0em;
  --tracking-label: 0.12em;

  /* --- Typography leading (line-height) --- */
  --leading-display: 0.95;
  --leading-heading: 1.05;
  --leading-title: 1.15;
  --leading-body: 1.6;
  --leading-caption: 1.5;
  --leading-label: 1.2;

  /* --- Z-index Scale --- */
  --z-behind: -10;
  --z-base: 0;
  --z-above: 10;
  --z-nav: 100;
  --z-overlay: 200;
  --z-modal: 1000;
}
